{
	"name": "flashcard",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "flashcard.simonepugliese.com",
			"custom_domain": true
		}
	],
	// Ogni 10 minuti il Worker decide se è ora di mandare una domanda su Telegram (vedi src/telegram.ts).
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"assets": {
		"directory": "./public"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flashcard",
			"database_id": "489c9264-6662-4e35-bb32-8bd9c214b609",
			"migrations_dir": "drizzle"
		}
	],
	// File dei materiali (immagini, PDF, testi): in D1 restano solo i metadati. Il bucket si crea con `wrangler r2 bucket create flashcard-files`.
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "flashcard-files"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false,
			"persist": false
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
}